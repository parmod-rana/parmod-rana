{
  "format": "VARDHANI_R3_R3E_42_FEATURE_SCHEMA_FREEZE_V1",
  "status": "FROZEN_BEFORE_ANY_R3E_MODEL_OUTPUT",
  "parent_family_contract": "same 42 causal raw NIFTY/SENSEX/VIX feature families preregistered in R3A and inherited unchanged through R3E",
  "purpose": "Resolve the previously family-level feature description into one deterministic 42-column implementation before any R3E model output is observed. This is a reconstruction freeze, not a claim that these byte-level formulas were recovered from an earlier source file.",
  "causal_rules": {
    "all_lags": "within same trading session only",
    "cross_market_alignment": "exact timestamp only; no forward filling",
    "future_values_in_features": false,
    "2025_market_content": "forbidden",
    "2026_market_content": "forbidden",
    "missing_cross_market_values": "NaN preserved for LightGBM native missing-value handling"
  },
  "columns": [
    {"name":"n_ret_1","formula":"10000*(NIFTY_close_t/NIFTY_close_t-1obs-1)"},
    {"name":"n_ret_2","formula":"10000*(NIFTY_close_t/NIFTY_close_t-2obs-1)"},
    {"name":"n_ret_3","formula":"10000*(NIFTY_close_t/NIFTY_close_t-3obs-1)"},
    {"name":"n_ret_5","formula":"10000*(NIFTY_close_t/NIFTY_close_t-5obs-1)"},
    {"name":"n_ret_10","formula":"10000*(NIFTY_close_t/NIFTY_close_t-10obs-1)"},
    {"name":"n_ret_15","formula":"10000*(NIFTY_close_t/NIFTY_close_t-15obs-1)"},
    {"name":"n_ret_30","formula":"10000*(NIFTY_close_t/NIFTY_close_t-30obs-1)"},
    {"name":"s_ret_1","formula":"10000*(SENSEX_close_t/SENSEX_close_t-1obs-1)"},
    {"name":"s_ret_2","formula":"10000*(SENSEX_close_t/SENSEX_close_t-2obs-1)"},
    {"name":"s_ret_3","formula":"10000*(SENSEX_close_t/SENSEX_close_t-3obs-1)"},
    {"name":"s_ret_5","formula":"10000*(SENSEX_close_t/SENSEX_close_t-5obs-1)"},
    {"name":"s_ret_10","formula":"10000*(SENSEX_close_t/SENSEX_close_t-10obs-1)"},
    {"name":"s_ret_15","formula":"10000*(SENSEX_close_t/SENSEX_close_t-15obs-1)"},
    {"name":"div_ret_1","formula":"n_ret_1-s_ret_1"},
    {"name":"div_ret_3","formula":"n_ret_3-s_ret_3"},
    {"name":"div_ret_5","formula":"n_ret_5-s_ret_5"},
    {"name":"div_ret_10","formula":"n_ret_10-s_ret_10"},
    {"name":"div_ret_15","formula":"n_ret_15-s_ret_15"},
    {"name":"vix_ret_1","formula":"10000*(VIX_close_t/VIX_close_t-1obs-1)"},
    {"name":"vix_ret_5","formula":"10000*(VIX_close_t/VIX_close_t-5obs-1)"},
    {"name":"vix_ret_15","formula":"10000*(VIX_close_t/VIX_close_t-15obs-1)"},
    {"name":"n_body_frac","formula":"(NIFTY_close-NIFTY_open)/NIFTY_close"},
    {"name":"n_range_frac","formula":"(NIFTY_high-NIFTY_low)/NIFTY_close"},
    {"name":"n_upper_wick_frac","formula":"(NIFTY_high-max(open,close))/NIFTY_close"},
    {"name":"n_lower_wick_frac","formula":"(min(open,close)-NIFTY_low)/NIFTY_close"},
    {"name":"n_atr14_pct","formula":"10000*WilderATR14/NIFTY_close; true range uses prior same-session close"},
    {"name":"n_rv_5","formula":"10000*population_std(log 1-observation close returns, trailing 5 same-session observations)"},
    {"name":"n_rv_15","formula":"10000*population_std(log 1-observation close returns, trailing 15 same-session observations)"},
    {"name":"n_rv_30","formula":"10000*population_std(log 1-observation close returns, trailing 30 same-session observations)"},
    {"name":"n_ema9_21_gap_pct","formula":"10000*(EMA9-EMA21)/NIFTY_close, same-session EMA"},
    {"name":"n_ema21_50_gap_pct","formula":"10000*(EMA21-EMA50)/NIFTY_close, same-session EMA"},
    {"name":"n_ema9_slope3_pct","formula":"10000*(EMA9_t-EMA9_t-3obs)/NIFTY_close"},
    {"name":"n_rsi14","formula":"Wilder RSI14 on same-session NIFTY close"},
    {"name":"n_trend_eff_5","formula":"abs(close_t-close_t-5obs)/sum(abs(diff(close)), trailing 5 same-session observations)"},
    {"name":"n_trend_eff_15","formula":"abs(close_t-close_t-15obs)/sum(abs(diff(close)), trailing 15 same-session observations)"},
    {"name":"n_trend_eff_30","formula":"abs(close_t-close_t-30obs)/sum(abs(diff(close)), trailing 30 same-session observations)"},
    {"name":"n_session_pos","formula":"(close-running_session_low)/(running_session_high-running_session_low)"},
    {"name":"n_dist_session_high_pct","formula":"10000*(running_session_high-close)/close"},
    {"name":"n_dist_session_low_pct","formula":"10000*(close-running_session_low)/close"},
    {"name":"n_opening_gap_pct","formula":"10000*(current_session_first_open/prior_session_last_close-1)"},
    {"name":"minute_sin","formula":"sin(2*pi*minutes_since_09_15/375)"},
    {"name":"minute_cos","formula":"cos(2*pi*minutes_since_09_15/375)"}
  ],
  "feature_count": 42,
  "economic_edge_claimed": false,
  "student_optimizer_steps": 0
}
